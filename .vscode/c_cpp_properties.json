{
    "configurations": [
        {
            "name": "Mingw64 Debug Config",
            "windowsSdkVersion": "10.0.18362.0",
            "compilerPath": "${env:MSYS2_ROOT_BASH}/mingw64/bin/gcc.exe",
            "includePath": [
                "${env:MSYS2_ROOT_BASH}/mingw64/include",
                "${workspaceFolder}/src/**"
            ],
            "defines": [
                "DEBUG",
                "_DEBUG",
                "__MINGW64__"
            ],
            "intelliSenseMode": "gcc-x64"
        },
        {
            "name": "Linux64 Debug Config",
            "compilerPath": "/usr/bin/gcc",
            "includePath": [
                "/usr/include",
                "/usr/local/include",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/deps/include/**"
            ],
            "defines": [
                "DEBUG",
                "_DEBUG"
            ],
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}